<!doctype html>
<html lang="{{ locale }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description }}">
    <meta name="theme-color" content="#03162f">
    <meta name="robots" content="{{ 'index,follow' if isProduction and not noindex else 'noindex,nofollow' }}">
    <meta http-equiv="Content-Security-Policy" content="{% if eventPreview and eventPreviewConfig.enabled %}default-src 'self'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://firebaseappcheck.googleapis.com https://{{ eventPreviewConfig.functionsRegion }}-{{ eventPreviewConfig.projectId }}.cloudfunctions.net; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/;{% elif eventPreview %}default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none';{% else %}default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none';{% endif %} object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="OnMyRadar">
    <meta property="og:title" content="{{ title }} · OnMyRadar">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="https://onmyradar.pro{{ page.url }}">
    <meta property="og:locale" content="{{ 'de_DE' if locale == 'de' else 'en_US' }}">
    <meta property="og:image" content="https://onmyradar.pro/icon-512.png">
    <meta property="og:image:width" content="512">
    <meta property="og:image:height" content="512">
    <meta property="og:image:alt" content="OnMyRadar">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }} · OnMyRadar">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="https://onmyradar.pro/icon-512.png">
    <link rel="canonical" href="https://onmyradar.pro{{ page.url }}">
    {% if alternateUrl %}
      <link rel="alternate" hreflang="{{ locale }}" href="https://onmyradar.pro{{ page.url }}">
      <link rel="alternate" hreflang="{{ 'de' if locale == 'en' else 'en' }}" href="https://onmyradar.pro{{ alternateUrl }}">
      <link rel="alternate" hreflang="x-default" href="https://onmyradar.pro{{ page.url if locale == 'en' else alternateUrl }}">
    {% endif %}
    <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}">
    <link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="any">
    <link rel="icon" type="image/png" href="{{ '/icon-192.png' | url }}">
    <link rel="apple-touch-icon" href="{{ '/icon-192.png' | url }}">
    <link rel="manifest" href="{{ '/site.webmanifest' | url }}">
    <title>{{ title }} · OnMyRadar</title>
    {% if isHome %}<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","name":"OnMyRadar","url":"https://onmyradar.pro/","email":"info@onmyradar.pro","logo":"https://onmyradar.pro/icon-512.png"},{"@type":"WebSite","name":"OnMyRadar","url":"https://onmyradar.pro/","inLanguage":["en-US","de-DE"]}]}</script>{% endif %}
  </head>
  <body>
    <a class="skip-link" href="#content">{{ 'Skip to content' if locale == 'en' else 'Zum Inhalt springen' }}</a>
    <header class="site-header">
      <a class="brand" href="{{ ('/' if locale == 'en' else '/de/') | url }}" aria-label="OnMyRadar {{ 'home' if locale == 'en' else 'Startseite' }}"><img src="{{ '/icon-192.png' | url }}" width="42" height="42" alt=""><span>OnMyRadar</span></a>
      <nav aria-label="{{ 'Main navigation' if locale == 'en' else 'Hauptnavigation' }}">
        <a class="nav-home" href="{{ ('/how-it-works/' if locale == 'en' else '/de/so-funktioniert-es/') | url }}">{{ 'How it works' if locale == 'en' else 'So funktioniert es' }}</a>
        <a class="nav-support" href="{{ ('/support/' if locale == 'en' else '/de/hilfe/') | url }}">{{ 'Support' if locale == 'en' else 'Hilfe' }}</a>
        {% if alternateUrl %}
          <span class="language-switcher" aria-label="{{ 'Language' if locale == 'en' else 'Sprache' }}"><a lang="en" hreflang="en" href="{{ (page.url if locale == 'en' else alternateUrl) | url }}"{% if locale == 'en' %} aria-current="page"{% endif %}>EN</a><a lang="de" hreflang="de" href="{{ (page.url if locale == 'de' else alternateUrl) | url }}"{% if locale == 'de' %} aria-current="page"{% endif %}>DE</a></span>
        {% endif %}
        <a class="nav-cta" href="mailto:info@onmyradar.pro?subject=OnMyRadar%20Beta">{{ 'Join beta' if locale == 'en' else 'Beta testen' }}</a>
      </nav>
    </header>
    <main id="content" tabindex="-1">{{ content | safe }}</main>
    <footer>
      <div><a class="brand footer-brand" href="{{ ('/' if locale == 'en' else '/de/') | url }}"><img src="{{ '/icon-192.png' | url }}" width="38" height="38" alt=""><span>OnMyRadar</span></a><p>{{ 'The things that matter, on your radar.' if locale == 'en' else 'Was dir wichtig ist – auf deinem Radar.' }}</p></div>
      <nav aria-label="{{ 'Legal and support' if locale == 'en' else 'Rechtliches und Hilfe' }}"><a href="{{ ('/privacy/' if locale == 'en' else '/de/privacy/') | url }}">{{ 'Privacy' if locale == 'en' else 'Datenschutz' }}</a><a href="{{ ('/terms/' if locale == 'en' else '/de/terms/') | url }}">{{ 'Terms' if locale == 'en' else 'Bedingungen' }}</a><a href="{{ ('/support/' if locale == 'en' else '/de/hilfe/') | url }}">{{ 'Support' if locale == 'en' else 'Hilfe' }}</a><a href="{{ ('/delete-account/' if locale == 'en' else '/de/konto-loeschen/') | url }}">{{ 'Delete account' if locale == 'en' else 'Konto löschen' }}</a></nav>
      <p class="copyright">© 2026 OnMyRadar · <a href="mailto:info@onmyradar.pro">info@onmyradar.pro</a></p>
    </footer>
  </body>
</html>
